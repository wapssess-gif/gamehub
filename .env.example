# PostgreSQL connection string (Neon, Supabase, Docker, локальный Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/gamehub"

# NextAuth v5 — required for production. Generate with: npx auth secret
# Production: use a strong random string (min 32 chars). Example:
# AUTH_SECRET="a7cca2d601bf20ff310a4e179cdecec9a0ea2d605dba34a8cd329f38e1403eb0"
AUTH_SECRET=""

# RAWG API key — получить на https://rawg.io/apidocs
RAWG_API_KEY=""

# Vercel Blob — хранилище загруженных аватаров профиля.
# Создать Blob store в дашборде Vercel (Storage), затем `vercel env pull`,
# либо вписать read-write токен вручную. Без него загрузка аватара
# отключается, остальной функционал работает.
BLOB_READ_WRITE_TOKEN=""

# Google OAuth — кнопка «Продолжить через Google» на /login и /register.
# Задайте обе переменные, чтобы включить. Без них доступен только вход
# по email + паролю.
#   1. https://console.cloud.google.com/apis/credentials → Create credentials
#      → OAuth client ID → Application type: Web application
#   2. Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
#      (для прода добавьте https://<домен>/api/auth/callback/google)
#   3. Настройте OAuth consent screen (External, scope email + profile)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Публичный базовый URL — нужен только в проде, чтобы OAuth-callback резолвился
# правильно. Локально определяется автоматически.
# AUTH_URL="https://gamehub.example.com"
